{
  "name": "self-knowledge-base-web",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build && pnpm size-check",
    "check:affected": "turbo run lint typecheck test --filter=...[origin/main]",
    "size-check": "node scripts/check-size-limits.mjs",
    "link-check": "lychee './**/*.md'",
    "generate:configs": "tsx scripts/generate-configs.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.0.0",
    "zod": "^3.23.0"
  }
}
