{
  "name": "self-knowledge-base-web",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint .",
    "lint:packages": "turbo run lint",
    "typecheck": "tsc -b",
    "typecheck:packages": "turbo run typecheck",
    "test": "vitest run",
    "test:packages": "turbo run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm size-check && pnpm lint:packages && pnpm typecheck:packages && pnpm test:packages",
    "check:affected": "turbo run lint typecheck test --filter=...[origin/main]",
    "size-check": "node scripts/check-size-limits.mjs",
    "link-check": "lychee --config .lychee.toml './**/*.md'",
    "generate:configs": "tsx scripts/generate-configs.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.5",
    "yaml": "^2.8.3",
    "zod": "^3.23.0"
  }
}
