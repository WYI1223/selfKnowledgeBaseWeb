---
/**
 * SSR rendering for `kind='viz'` jupyter block.
 *
 * Astro is a pre-render path; the kernel runs CLIENT-SIDE only (Pyodide
 * is a heavy WASM bundle — the SSR HTML must be a static placeholder
 * that the editor / NodeView hydrates against). We therefore render only
 * the code as `<pre><code>`; status indicator + Run button + output
 * panel materialize on hydration via `JupyterView` in `Jupyter.tsx`.
 *
 * Static markup matches `<pre className="skb-jupyter-code" ...>` so
 * jupyter.css applies identically pre- and post-hydration (no FOUC class
 * mismatch). The hydration boundary is owned by the editor-shell / apps/site
 * consumer; this Astro surface is the static-only authority.
 */

interface Props {
  code: string;
  showLineNumbers?: boolean;
}

const { code, showLineNumbers = true } = Astro.props;
const lines = code === '' ? [''] : code.split('\n');
---

<div data-block="jupyter" data-phase="idle">
  <pre
    class="skb-jupyter-code"
    data-line-numbers={String(showLineNumbers)}
  >
    {showLineNumbers
      ? lines.map((line, i) => (
          <span class="skb-jupyter-line">
            <span class="skb-jupyter-lineno" aria-hidden="true">{i + 1}</span>
            <code>{line}</code>
          </span>
        ))
      : <code>{code}</code>}
  </pre>
</div>
