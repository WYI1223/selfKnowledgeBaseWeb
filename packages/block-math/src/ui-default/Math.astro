---
import { renderMath } from './render-math';

interface Props {
  expression: string;
  display?: boolean;
}

const { expression, display = false } = Astro.props;

// KaTeX 渲染走 `./render-math.ts` 单一权威，与 Math.tsx 同源
// （ADR-0006 item #5 algorithm replication：authority = renderMath；不允许在
// 此文件内 inline `katex.renderToString` + options literal）。
const html = renderMath(expression, display);

const Tag = display ? 'div' : 'span';
---

<Tag data-block="math" data-display={String(display)} set:html={html} />
