---
import { renderPdf } from './render-pdf';

interface Props {
  src: string;
  page?: number;
  searchable?: boolean;
}

const { src, page = 1, searchable = false } = Astro.props;

// PDF 渲染走 `./render-pdf.ts` 单一权威，与 Pdf.tsx 同源
// （ADR-0006 item #5 algorithm replication：authority = renderPdf；不允许在
// 此文件内 inline iframe src 构造 + URL 拼接）。
const desc = renderPdf(src, page, searchable);
---

<div
  data-block={desc.dataAttrs['data-block']}
  data-page={desc.dataAttrs['data-page']}
  data-searchable={desc.dataAttrs['data-searchable']}
>
  <iframe src={desc.iframeSrc} title={`PDF: ${desc.src}`} loading="lazy"></iframe>
</div>
