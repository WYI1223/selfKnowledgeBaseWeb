---
// Wave 6 cf-20a (2026-05-09) — wrap the heavy-block island in the v2
// `.skb-block-static` chrome shell so the read route gets the same
// per-kind stripe + border + radius as the editor mount path. The
// shared chrome rules live in `@skb/editor-shell/src/block-chrome.css`
// (imported by `apps/site/src/styles/global.css`).
//
// Wave 6 cf-20b (2026-05-09) — grid placement. Apply `style.gridColumn`
// / `style.gridRow` derived from `Astro.props.{col, row?, colSpan, rowSpan}`
// per ADR-0016 D2 + D8 + v0.2 D11.1 amendment. The shared
// `gridPlacementStyleAttr` helper from `@skb/editor-shell/src/grid-style`
// is the single source of the formula across `BlockNodeView.tsx` (editor),
// `apps/site/src/lib/mdx-adapter.ts` (5 light blocks read), and the 3
// heavy block Astro wrappers (this file + NnViz.astro + AgentFlow.astro).
import JupyterIsland from '../islands/JupyterIsland';
// Deep-subpath (NOT barrel) — see mdx-adapter.ts for the rationale.
import {
  extractGridPosition,
  gridPlacementStyleAttr,
} from '@skb/editor-shell/src/grid-style.ts';

const gridPos = extractGridPosition(Astro.props as Record<string, unknown>);
const styleAttr = gridPos ? gridPlacementStyleAttr(gridPos) : undefined;
---

<div class="skb-block-static" data-skb-block-kind="jupyter" style={styleAttr}>
  <JupyterIsland client:load {...Astro.props} />
</div>
