---
import { EditorShellMount } from './EditorShellMount.tsx';

interface Props {
  slug: string;
  initialMdx?: string;
  editMode?: boolean;
}

const { slug, initialMdx = '', editMode = false } = Astro.props as Props;
---

<div class="editor-shell-mount">
  <EditorShellMount client:only="react" slug={slug} initialMdx={initialMdx} editMode={editMode} />
</div>
