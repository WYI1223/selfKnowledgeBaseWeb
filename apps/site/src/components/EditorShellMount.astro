---
import { EditorShellMount } from './EditorShellMount.tsx';

interface Props {
  slug: string;
  initialMdx?: string;
}

const { slug, initialMdx = '' } = Astro.props as Props;
---

<div class="editor-shell-mount">
  <EditorShellMount client:only="react" slug={slug} initialMdx={initialMdx} />
</div>
