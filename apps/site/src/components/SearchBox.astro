<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<div id="search" class="skb-search"></div>

<script>
  import { PagefindUI } from '@pagefind/default-ui';
  import { isWordLevelMatch } from '../lib/word-level-match';

  type PagefindSubResult = {
    excerpt?: string;
    title?: string;
  };

  type PagefindResultPayload = {
    content?: string;
    excerpt?: string;
    meta?: {
      title?: string;
    };
    sub_results?: PagefindSubResult[];
  };

  const MISMATCH_ATTR = 'data-skb-word-level-mismatch';
  const SENTINEL_CLASS = 'skb-word-level-mismatch-marker';
  const SEARCH_ROOT_SELECTOR = '#search';
  const INPUT_SELECTOR = `${SEARCH_ROOT_SELECTOR} input[type="text"], ${SEARCH_ROOT_SELECTOR} input[type="search"]`;
  const RESULT_SELECTOR = `${SEARCH_ROOT_SELECTOR} li.pagefind-ui__result`;
  const MESSAGE_SELECTOR = `${SEARCH_ROOT_SELECTOR} .pagefind-ui__message`;

  let lastSearchTerm = '';

  new PagefindUI({
    element: SEARCH_ROOT_SELECTOR,
    baseUrl: '/',
    resetStyles: false,
    processTerm: (term: string) => {
      lastSearchTerm = normalizeTerm(term);
      return lastSearchTerm;
    },
    processResult: (result: PagefindResultPayload) => {
      if (!lastSearchTerm) return result;

      const resultText = resultTextContent(result);
      if (matchesEveryQueryTerm(lastSearchTerm, resultText)) return result;

      result.excerpt = appendMismatchMarker(result.excerpt ?? '');
      return result;
    },
  });

  const searchRoot = document.querySelector(SEARCH_ROOT_SELECTOR);
  const boundInputs = new WeakSet<HTMLInputElement>();
  let rafId: number | null = null;

  if (searchRoot) {
    bindSearchInputs(searchRoot);

    const observer = new MutationObserver(() => {
      bindSearchInputs(searchRoot);
      scheduleResultReconciliation();
    });
    observer.observe(searchRoot, { subtree: true, childList: true });
  }

  function bindSearchInputs(root: ParentNode): void {
    for (const input of root.querySelectorAll<HTMLInputElement>(INPUT_SELECTOR)) {
      if (boundInputs.has(input)) continue;
      boundInputs.add(input);
      input.addEventListener('input', () => {
        lastSearchTerm = normalizeTerm(input.value);
      });
    }
  }

  function scheduleResultReconciliation(): void {
    if (rafId !== null) return;
    rafId = requestAnimationFrame(() => {
      rafId = null;
      reconcileResults();
    });
  }

  function reconcileResults(): void {
    const results = Array.from(document.querySelectorAll<HTMLElement>(RESULT_SELECTOR));
    for (const result of results) {
      if (result.querySelector(`.${SENTINEL_CLASS}`)) {
        result.setAttribute(MISMATCH_ATTR, 'true');
      } else {
        result.removeAttribute(MISMATCH_ATTR);
      }
    }
    updateCountDisplay(results);
  }

  function updateCountDisplay(results: HTMLElement[]): void {
    const hiddenCount = results.filter((result) => result.getAttribute(MISMATCH_ATTR) === 'true').length;
    if (hiddenCount === 0) return;

    const message = document.querySelector<HTMLElement>(MESSAGE_SELECTOR);
    if (!message) return;

    const total = results.length;
    const visible = total - hiddenCount;
    const text = message.textContent ?? '';
    const countText = `${visible}/${total}`;
    if (text.includes(countText)) return;

    const nextText = text.replace(/\b[\d,]+(?:\/[\d,]+)?\b/u, countText);
    if (nextText !== text) {
      message.textContent = nextText;
    }
  }

  function normalizeTerm(term: string): string {
    return term.trim().toLowerCase();
  }

  function matchesEveryQueryTerm(term: string, content: string): boolean {
    const terms = term.split(/\s+/).filter(Boolean);
    return terms.length > 0 && terms.every((queryTerm) => isWordLevelMatch(queryTerm, content));
  }

  function resultTextContent(result: PagefindResultPayload): string {
    const subResults = result.sub_results ?? [];
    const parts = [
      result.meta?.title,
      result.excerpt,
      result.content,
      ...subResults.flatMap((subResult) => [subResult.title, subResult.excerpt]),
    ];

    return stripHtml(parts.filter(Boolean).join(' '));
  }

  function appendMismatchMarker(excerpt: string): string {
    if (excerpt.includes(SENTINEL_CLASS)) return excerpt;
    return `${excerpt}<span class="${SENTINEL_CLASS}" hidden aria-hidden="true"></span>`;
  }

  function stripHtml(html: string): string {
    const div = document.createElement('div');
    div.innerHTML = html;
    return div.textContent ?? '';
  }
</script>

<style is:global>
  #search [data-skb-word-level-mismatch="true"] {
    display: none !important;
  }
</style>
