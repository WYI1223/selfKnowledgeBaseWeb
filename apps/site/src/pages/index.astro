---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

type NoteEntry = CollectionEntry<'notes'>;

const notes: NoteEntry[] = (await getCollection('notes'))
  .filter((note: NoteEntry) => !note.data.draft)
  .sort((a: NoteEntry, b: NoteEntry) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="SelfKnowledgeBaseWeb">
  <h1>Notes</h1>
  <ul>
    {
      notes.map((note: NoteEntry) => (
        <li>
          <a href={`/notes/${note.id.replace(/\/index$/, '')}`}>{note.data.title}</a>
          <small> — {note.data.date.toISOString().slice(0, 10)}</small>
        </li>
      ))
    }
  </ul>
</BaseLayout>
