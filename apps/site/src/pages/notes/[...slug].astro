---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter(
    (note: CollectionEntry<'notes'>) => !note.data.draft,
  );
  return notes.map((note: CollectionEntry<'notes'>) => ({
    params: { slug: note.id.replace(/\/index$/, '') },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}
const { note } = Astro.props as Props;
const { Content } = await render(note);
const componentBlockTag =
  /<(Callout|Code|Image|Math|Pdf|Jupyter|NnViz|AgentFlow)(\s|>|\/)/;
const componentsMap = componentBlockTag.test(note.body ?? '')
  ? (await import('../../components')).componentsMap
  : {};
---

<BaseLayout title={note.data.title} wide>
  <article>
    <h1>{note.data.title}</h1>
    {/*
      Wave 6 cf-20b R2 (2026-05-09) — combine `.skb-grid` and
      `.skb-prose` onto a SINGLE wrapper so MDX-emitted children
      (`.skb-block-static` + prose `<p>` / `<h2>`) become DIRECT
      children of `.skb-grid` and participate in the 12-col grid
      layout per ADR-0016 v0.2 D11.1 amendment.

      Pre-cf-20b-R2 the structure was `<div class="skb-grid"><div
      class="skb-prose"><Content/></div></div>` — `.skb-block-static`
      ended up as a grandchild of `.skb-grid`, so its inline
      `style="grid-column: 1 / span 12"` was inert (no grid-item
      context). codex-pr-reviewer-55 R2 caught this structural bug.

      `.skb-prose` rules are typography selectors (`.skb-prose p`,
      `.skb-prose .b-callout`, etc.) that apply to descendants only;
      adding `.skb-prose` to the same element as `.skb-grid` creates
      no rule conflict with the grid layout. Verified by inspection
      of `apps/site/src/styles/prose.css` (no rule targets `.skb-prose`
      itself) and the cf-20b R2 grid-layout Playwright spec which
      asserts both grid-item-ness AND `getBoundingClientRect()` width.
    */}
    <div class="skb-grid skb-prose">
      <Content components={componentsMap} />
    </div>
  </article>
</BaseLayout>
