---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter(
    (note: CollectionEntry<'notes'>) => !note.data.draft,
  );
  return notes.map((note: CollectionEntry<'notes'>) => ({
    params: { slug: note.id.replace(/\/index$/, '') },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}
const { note } = Astro.props as Props;
const { Content } = await render(note);
---

<BaseLayout title={note.data.title}>
  <article>
    <h1>{note.data.title}</h1>
    <Content />
  </article>
</BaseLayout>
