---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import '../../../styles/grid.css';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter(
    (note: CollectionEntry<'notes'>) => !note.data.draft,
  );
  return notes.map((note: CollectionEntry<'notes'>) => ({
    params: { slug: note.id.replace(/\/index$/, '') },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props as Props;
const slug = note.id.replace(/\/index$/, '');
---

<BaseLayout title={`Edit: ${note.data.title}`} wide>
  <article>
    <h1>Edit: {note.data.title}</h1>
    <section
      data-skb-edit-placeholder
      style="padding: 32px; border: 2px dashed oklch(80% 0.01 80); border-radius: 8px; background: oklch(98% 0.005 80); color: oklch(40% 0.02 80); font-family: system-ui, sans-serif;"
    >
      <h2 style="margin: 0 0 12px;">Edit route — Wave 8 W8-1 demolition placeholder</h2>
      <p style="margin: 0 0 8px; line-height: 1.6;">
        The Tiptap-NodeView grid editor (cf-19/20/22/23/24/25) has been torn
        down. The new <code>GridEditor</code> per Wave 8 plan (engine state as
        React SoT) lands in W8-2.
      </p>
      <p style="margin: 0; font-size: 13px; opacity: 0.7;">
        Note slug: <code>{slug}</code>. View read-only at
        <a href={`/notes/${slug}`}>/notes/{slug}</a>.
      </p>
    </section>
  </article>
</BaseLayout>
