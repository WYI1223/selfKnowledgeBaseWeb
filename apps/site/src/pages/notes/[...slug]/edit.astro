---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorShellMount from '../../../components/EditorShellMount.astro';
import '../../../styles/grid.css';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter(
    (note: CollectionEntry<'notes'>) => !note.data.draft,
  );
  return notes.map((note: CollectionEntry<'notes'>) => ({
    params: { slug: note.id.replace(/\/index$/, '') },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props as Props;
const slug = note.id.replace(/\/index$/, '');
---

<BaseLayout title={`Edit: ${note.data.title}`} wide palette>
  <article>
    <h1>Edit: {note.data.title}</h1>
    <EditorShellMount slug={slug} initialMdx={note.body ?? ''} editMode />
  </article>
</BaseLayout>
