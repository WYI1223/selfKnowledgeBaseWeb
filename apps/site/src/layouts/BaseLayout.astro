---
import '../styles/global.css';
import '../styles/grid.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  /**
   * Wave 6 cf-23 — opt-in v2 doc-wrap layout for `/notes/*` routes.
   *
   * When `true`, `<main>` swaps from the narrow Tailwind `prose
   * mx-auto max-w-3xl py-12 px-4` shell to the v2-aligned
   * `mx-auto py-10 px-4 lg:px-12 notes-doc-wrap` shell with inline
   * `style="max-width: 1180px"` (per `/mnt/d/download/web/v2-styles.css:122-127`
   * `.doc-wrap`). The Tailwind `prose` class is intentionally dropped
   * on the wide path so v2 typography tokens (`--font-size-body 15px`,
   * `--font-size-b-p 14.5px`, `--line-height-body 1.55`) cascade into
   * `<main>` without being shadowed by Tailwind Typography preset rules.
   *
   * BOTH `notes/[...slug].astro` (read) AND `notes/[...slug]/edit.astro`
   * (edit) pass `wide` so the page-shell layer stays in lockstep
   * (mirrors how cf-20a kept the block-chrome layer in lockstep via
   * `block-chrome.css` paired selectors). Per ADR-0018 v0.7 D9 +
   * `apps/site/playwright/notes-route-width-parity.spec.ts` 4-viewport
   * lock + `apps/site/playwright/sample-blocks-read-no-edit-affordances.spec.ts`
   * D8 zero-affordance lock.
   *
   * Non-notes routes (`/`, `/search`) leave `wide` unset to preserve
   * the existing `prose max-w-3xl` typography. D2.b widening-all-routes
   * was explicitly rejected at cf-23 PLAN per orchestrator approval.
   */
  wide?: boolean;
}
const { title, wide = false } = Astro.props;

const mainClassName = wide
  ? 'mx-auto py-10 px-4 lg:px-12 notes-doc-wrap'
  : 'prose mx-auto max-w-3xl py-12 px-4';
const mainStyle = wide ? 'max-width: 1180px;' : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // FOUC bridge: runs before any island hydrates so first paint already
      // matches the chosen theme. Reads STORAGE_KEY ('skb-theme') literally
      // from @skb/design-tokens; renaming requires updating BOTH packages
      // (apps/site cannot import the constant — load order forbids it).
      // This script intentionally does NOT write localStorage (ADR-0003 D6:
      // persistence is coupled to manual user action only).
      //
      // ALGORITHM MUST stay byte-equivalent with `getInitialTheme()` in
      // packages/design-tokens/src/use-theme.ts in BOTH happy-path AND
      // exception handling:
      //   1. STRICT-whitelist saved value (only 'light' or 'dark' are
      //      honored). A truthy-coerce check would diverge for invalid /
      //      case-mismatched / legacy localStorage values.
      //   2. The try/catch MUST wrap ONLY the localStorage.getItem call.
      //      matchMedia + DOM apply MUST run AFTER the catch handler.
      //      A wide-scope try/catch swallows the matchMedia path on
      //      Safari Private Mode / iOS WebView / disabled-storage browsers,
      //      causing a hydration flash when system pref is dark.
      // Both rules are enforced by the regression test
      // apps/site/src/__tests__/fouc-script.test.ts (saved-value corpus
      // + storage-throws rows).
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('skb-theme');
        } catch (e) {
          /* localStorage unavailable; saved stays null and we fall through to matchMedia */
        }
        var theme;
        if (saved === 'light' || saved === 'dark') {
          theme = saved;
        } else {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }
        if (theme === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class="bg-bg text-fg">
    <header class="border-b border-border">
      <nav class="mx-auto max-w-3xl flex items-center justify-between py-4 px-4">
        <a href="/" class="font-bold">SelfKnowledgeBaseWeb</a>
        <div class="flex items-center gap-4">
          <a href="/search" class="text-sm font-medium">Search</a>
          <ThemeToggle />
        </div>
      </nav>
    </header>
    <main class={mainClassName} style={mainStyle}>
      <slot />
    </main>
  </body>
</html>
