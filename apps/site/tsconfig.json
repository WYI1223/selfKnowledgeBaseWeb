{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@layouts/*": ["src/layouts/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "../../content/**/*",
    "playwright/**/*.ts",
    "tailwind.config.ts",
    "astro.config.mjs",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist"],
  "references": [
    { "path": "../../packages/block-agent-flow" },
    { "path": "../../packages/block-callout" },
    { "path": "../../packages/block-code" },
    { "path": "../../packages/block-image" },
    { "path": "../../packages/block-jupyter" },
    { "path": "../../packages/block-math" },
    { "path": "../../packages/block-nn-viz" },
    { "path": "../../packages/block-pdf" }
  ]
}
