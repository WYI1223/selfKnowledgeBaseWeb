# Local Claude Code settings (per-user, not shared)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/skills/

# Per-user agent / codex / IDE tool artifacts (not shared)
.agents/
.codex
.codex-runs/
opencode.json
skills-lock.json

# Astro per-package build cache
apps/*/.astro/

# Node
node_modules/
.pnpm-store/
.turbo/
dist/
build/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
.env.local
.env.*.local

# OS / IDE
.DS_Store
Thumbs.db
*.swp
.vscode/settings.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Build / coverage outputs
coverage/
.cache/

# Generator scratch (manual user merge into ~/.codex/config.toml)
# Track tmp/codex-profiles.toml (generated artifact, drift-checked in CI)
tmp/*
!tmp/codex-profiles.toml

# Playwright MCP runtime cache (mcp playwright tool stores transient
# snapshots, console logs, screenshots here per-session). Not part of
# the project artifact set — codex stage 5 commit MUST NOT include.
.playwright-mcp/
